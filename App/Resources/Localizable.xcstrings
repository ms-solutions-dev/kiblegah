          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting hamza"
          }
        }
      }
    },
    "tecvid.hamzat_wasl.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki kelimeye bağlanırken okunmayan elif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alif, das beim Verbinden mit dem vorigen Wort nicht gelesen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alif that is silent when joined to the previous word."
          }
        }
      }
    },
    "tecvid.idghaam_ghunnah": {
      "extractionState": "manual",
