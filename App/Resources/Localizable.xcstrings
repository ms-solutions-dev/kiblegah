    "ayar.icloud.alt": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notların, kayıtların ve okuma durumun kendi iCloud hesabında saklanır. Bize hiçbir şey gelmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, Gemerktes und Lesestand liegen in deiner eigenen iCloud. Bei uns kommt nichts an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes, saved items and reading progress are stored in your own iCloud. Nothing reaches us."
          }
        }
      }
    },
