    "gizlilik.bildirim": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler cihazında planlanır; hiçbir sunucu sana bildirim göndermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen werden auf dem Gerät geplant; kein Server schickt dir etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are scheduled on your device; no server sends you anything."
          }
        }
      }
    },
    "gizlilik.harita": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehir aradığında ya da konumun adı bulunurken Apple Haritalar kullanılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Städtesuche und den Ortsnamen wird Apple Karten genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps is used for city search and to name your location."
          }
        }
      }
    },
    "gizlilik.icloud": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud eşitlemesi kapalıdır. Açarsan veriler kendi iCloud hesabına gider, bize değil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Abgleich ist aus. Schaltest du ihn ein, gehen die Daten in deine eigene iCloud, nicht zu uns."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is off. If you turn it on, data goes to your own iCloud, not to us."
          }
        }
      }
    },
    "gizlilik.konum": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun sadece cihazında kullanılır: Kıble yönü ve vakitler burada hesaplanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wird nur auf dem Gerät verwendet: Qibla-Richtung und Gebetszeiten werden hier berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used only on your device: the Qibla direction and prayer times are calculated here."
          }
        }
      }
    },
    "gizlilik.reklam": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam yok, takip yok, analiz yok. Uygulama hesap istemez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung, kein Tracking, keine Analyse. Die App braucht kein Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, no tracking, no analytics. The app needs no account."
          }
        }
      }
    },
    "gizlilik.ses": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıraat internetten çalınırken ses dosyaları Quran.com (Quran Foundation)'dan gelir; indirilen sureler cihazında kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden Rezitationen gestreamt, kommen die Dateien von Quran.com (Quran Foundation); geladene Suren bleiben auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recitations stream, the files come from Quran.com (Quran Foundation); downloaded surahs stay on your device."
          }
        }
      }
    },
