    "ayar.vakit_hesabi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit hesabı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnung der Gebetszeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer time calculation"
          }
        }
      }
    },
    "ayar.vakit_hesabi.alt": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Diyanet takvimi“ ilçenin Diyanet koordinatını (ve varsa vakit sunucusunu) kullanır; vakitler camideki takvimle neredeyse her gün dakikası dakikasına aynıdır (en fazla 1 dakika fark). İlçe bilinmiyorsa konum kullanılır. „Konumuma göre“ tam bulunduğunuz nokta için hesaplar; yazın imsak ve yatsı takvimden birkaç dakika sapabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Diyanet-Kalender“ nimmt Diyanets Koordinate des Ortes (İlçe) und, falls eingetragen, den Vakit-Dienst; die Zeiten stimmen fast immer auf die Minute mit dem Kalender der Moschee überein (höchstens 1 Minute Unterschied). Ist kein Diyanet-Ort bekannt, gilt der Standort. „Nach meinem Standort“ rechnet genau für den Punkt, an dem du bist; im Sommer können Fajr und Isha dann einige Minuten vom Kalender abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Diyanet calendar\" uses Diyanet's own coordinate for the district (ilçe) and, if set, the prayer time server, so times almost always match the mosque calendar to the minute (at most 1 minute apart). Without a known district, your location is used. \"By my location\" calculates for your exact position; in summer, imsak and yatsı may then differ from the calendar by a few minutes."
          }
        }
      }
    },
    "ayar.vakit_hesabi.diyanet": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet takvimi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet-Kalender"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet calendar"
          }
        }
      }
    },
