    "kuran.kiraat.farkli": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kâri Hafs dışında bir kıraatle okuyor; metin Hafs'tır. Bazı kelimeler ve ayet sınırları farklı olabilir, işaretlenen ayet yaklaşıktır."
