    "konum.gizlilik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun cihazında kalır. Şehir adı için Apple Haritalar kullanılır; vakit sunucusuna sadece ilçe adı gider ve kaydedilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort bleibt auf dem Gerät. Für den Ortsnamen wird Apple Karten genutzt; an den Vakit-Server geht nur der Ortsname, gespeichert wird nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on your device. Apple Maps is used for the place name; only the district name goes to the prayer-time server, and nothing is stored."
          }
        }
      }
    },
    "konum.izin_ac": {
