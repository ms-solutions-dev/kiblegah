    "mushaf.fassung.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin mushaf cihazına bir kez iner, sonra internetsiz açılır. Başkasını seçersen yenisi iner, eskisi silinir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Mushaf wird einmal geladen und öffnet danach ohne Internet. Wählst du einen anderen, kommt der neue und der alte wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mushaf you choose downloads once and then opens without internet. If you pick another one, it downloads and the old one is removed."
          }
        }
      }
    },
