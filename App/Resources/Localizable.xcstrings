        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers, Dua, Name … (z. B. Geduld, 2:255)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse, dua, name… (e.g. patience, 2:255)"
