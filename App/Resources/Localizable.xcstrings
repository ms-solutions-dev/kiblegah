    "kible.kalibre.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu yavaşça, havada yatay bir sekiz çizer gibi 3–4 kez hareket ettir. Doğruluk iyi olunca devam ederiz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweg das Handy langsam 3–4 Mal, als würdest du eine liegende Acht in die Luft malen. Sobald die Genauigkeit gut ist, geht es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly move your phone 3–4 times as if drawing a figure eight in the air. We'll continue once accuracy is good."
          }
        }
      }
    },
    "kible.kalibre.atla": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik atla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorerst überspringen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip for now"
          }
        }
      }
    },
    "kible.kalibre.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce pusulayı ayarlayalım"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst den Kompass einstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's calibrate the compass first"
          }
        }
      }
    },
    "kible.kalibre.dusuk": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğruluk düşük · ±25°"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genauigkeit gering · ±25°"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low accuracy · ±25°"
          }
        }
      }
    },
    "kible.kamera": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        }
      }
    },
    "kible.kamera.izin_yok": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni yok. Pusula ve harita kameradan bağımsız çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kamerazugriff. Kompass und Karte funktionieren auch ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera access. Compass and map work without it."
          }
        }
      }
    },
    "kible.kamera.not": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera da pusulayı kullanır; parazit varsa kontrol için haritayı kullan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera nutzt auch den Kompass; bei Störung prüf lieber mit der Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera also uses the compass; if there's interference, check with the map."
          }
        }
      }
    },
    "kible.kontrol.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı doğrudan Kıble pusulasında açar. Kilit ekranında: basılı tut, kilidi aç, Kıble açılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die App direkt im Qibla-Kompass. Auf dem Sperrbildschirm: gedrückt halten, entsperren, die Qibla öffnet sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the app straight to the Qibla compass. On the Lock Screen: press and hold, unlock, and the Qibla opens."
          }
        }
      }
    },
    "kible.kontrol.baslik": {
