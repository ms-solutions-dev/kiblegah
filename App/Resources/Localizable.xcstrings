{
  "sourceLanguage": "en",
  "strings": {
    "arama.anlam": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlamca yakın ayetler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhaltlich verwandte Verse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verses with a related meaning"
          }
        }
      }
    },
    "arama.anlam.not": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayetlerde aradığın kelime geçmeyebilir; cihazında anlamına göre bulundu. Deneme aşamasında."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verse enthalten dein Suchwort vielleicht nicht – sie wurden auf deinem Gerät nach der Bedeutung gefunden. Noch im Versuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These verses may not contain your search word – they were found on your device by meaning. Still experimental."
          }
        }
      }
    },
    "arama.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyde ara"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überall suchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search everything"
