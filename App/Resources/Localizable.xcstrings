    "tecvid.ghunnah.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeddeli nun ve mim genizden, yaklaşık iki hareke okunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nun und Mim mit Schadda werden nasal, etwa zwei Haraka lang gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nun and meem with shadda are nasalised for about two counts."
          }
        }
      }
    },
    "tecvid.hamzat_wasl": {
      "extractionState": "manual",
