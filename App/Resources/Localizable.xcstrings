    "ezber.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelimeler gizli; hatırlamaya çalış, dokunarak aç. Sonra nasıl geçtiğini seç – uygulama tekrarı ona göre planlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter sind verdeckt; versuch dich zu erinnern und tipp sie auf. Danach sag, wie es lief – die App plant die Wiederholung danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words are hidden; try to recall them and tap to reveal. Then say how it went – the app schedules the next review."
          }
        }
      }
    },
