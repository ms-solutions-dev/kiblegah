    "bildirim.planli.alt": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone en fazla 64 bildirimi önceden kabul eder. Uygulamayı her açtığında yeniden planlarız; 2 gün kala seni bir kez uygulamayı açmaya çağırırız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone nimmt höchstens 64 Mitteilungen im Voraus an. Bei jedem Öffnen planen wir neu; 2 Tage vor dem Ende erinnern wir dich einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone accepts at most 64 notifications in advance. We reschedule each time you open the app and remind you once, 2 days before they run out."
          }
        }
      }
    },
