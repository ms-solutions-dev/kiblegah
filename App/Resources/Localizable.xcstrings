      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Med harfinden sonra aynı kelimede hemze gelir: 4–5 hareke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
