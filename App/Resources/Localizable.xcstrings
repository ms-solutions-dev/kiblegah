    "kible.harita.ipucu": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizgi Kâbe'ye gider. Telefonu değil, çizgiyi binalara ve sokaklara göre hizala."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linie führt zur Kaaba. Richte dich nach Gebäuden und Straßen aus, nicht nach dem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line leads to the Kaaba. Align yourself with buildings and streets, not the phone."
          }
        }
      }
    },
