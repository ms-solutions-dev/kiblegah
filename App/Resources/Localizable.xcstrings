        }
      }
    },
    "arama.ipucu": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kelime ya da ayet numarası yaz. Mealler, okunuş, dualar ve Esmâ'da aranır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein Wort oder eine Versnummer ein. Gesucht wird in Übersetzungen, Aussprache, Duas und den 99 Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a word or a verse number. Translations, transliteration, duas and the 99 names are searched."
          }
        }
      }
    },
    "arama.istem": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayet, dua, isim… (ör. sabır, 2:255)"
