    "kerahat.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerahat vakitleri, namaz kılmanın mekruh sayıldığı üç kısa zaman dilimidir: güneş doğarken, tam tepedeyken ve batarken. Uygulama bu vakitleri şöyle gösterir:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Makruh-Zeiten sind drei kurze Abschnitte, in denen das Gebet als makruh (unerwünscht) gilt: beim Sonnenaufgang, wenn die Sonne im Zenit steht, und beim Sonnenuntergang. Die App zeigt sie so:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makruh times are three short periods in which praying is disliked: at sunrise, when the sun is at its zenith, and at sunset. The app shows them like this:"
          }
        }
      }
    },
    "kerahat.bant %@": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerahat vakti · %@ itibarıyla yeniden namaz kılabilirsin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Makruh-Zeit · ab %@ kannst du wieder beten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makruh time · you can pray again from %@"
          }
        }
      }
    },
    "kerahat.nedir": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerahat nedir?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist eine Makruh-Zeit?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is makruh time?"
          }
        }
      }
    },
    "kerahat.not": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreler yaklaşıktır. Doğuştan sonraki süreyi Ayarlar'dan değiştirebilirsin. Güneş batarkenki kerahat vaktinde, o günün ikindi namazının farzı henüz kılınmadıysa kılınır (Diyanet). Ayrıntılar için bir hocaya danış."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauern sind Näherungen. Die Dauer nach Sonnenaufgang kannst du in den Einstellungen ändern. In der Makruh-Zeit vor Sonnenuntergang darf das noch nicht verrichtete Asr-Fard desselben Tages gebetet werden (Diyanet). Für Einzelheiten frag einen Imam oder Gelehrten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The durations are approximate. You can change the period after sunrise in Settings. In the makruh time before sunset, that day's Asr fard may still be prayed if not yet done (Diyanet). For details, ask a scholar."
          }
        }
      }
    },
    "kerahat.pencere.batis %lld": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş batmadan önceki %lld dakika (Diyanet fetvasına göre gerçek batışa göre)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Minuten vor dem tatsächlichen Sonnenuntergang (nach der Diyanet-Fetva)"
