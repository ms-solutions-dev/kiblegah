    "kible.harita.cevrimdisi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet yok, harita yüklenemiyor. Pusula internetsiz de çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Internet, die Karte lädt nicht. Der Kompass geht auch offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet, so the map can't load. The compass works offline too."
          }
        }
      }
    },
    "kible.harita.duz_tut": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu düz tut"
          }
        },
