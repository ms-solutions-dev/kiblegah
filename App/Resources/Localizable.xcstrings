    "tecvid.lam_shamsiyyah.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şemsî harflerden önceki lâm okunmaz; sonraki harf şeddeli okunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lam vor Sonnenbuchstaben wird nicht gelesen; der folgende Buchstabe wird verdoppelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lam before sun letters is silent; the next letter is doubled."
          }
        }
      }
    },
