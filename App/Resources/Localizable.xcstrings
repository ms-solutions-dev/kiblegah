    "tecvid.ikhfa.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenvin ya da sakin nun, ihfâ harflerinden önce gizlenerek genizden okunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanwin oder Nun mit Sukun wird vor den Ikhfa-Buchstaben verborgen und nasal gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanween or silent nun is concealed and nasalised before the ikhfa letters."
          }
        }
      }
    },
