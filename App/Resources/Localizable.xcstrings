    "tecvid.idghaam_ghunnah.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenvin ya da sakin nun; ي ن م و harflerine genizden katılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanwin oder Nun mit Sukun verschmilzt nasal mit ي ن م و."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanween or silent nun merges into ي ن م و with nasalisation."
          }
        }
      }
    },
    "tecvid.idghaam_mutajanisayn": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İdğam-ı mütecâniseyn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Idgham gleicher Artikulation"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idgham of same articulation"
          }
        }
      }
    },
    "tecvid.idghaam_mutajanisayn.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahreçleri aynı, sıfatları farklı iki harf: ilki ikincisine katılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Buchstaben vom selben Artikulationsort: der erste geht im zweiten auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two letters from the same point of articulation: the first merges into the second."
          }
        }
      }
    },
    "tecvid.idghaam_mutaqaribayn": {
      "extractionState": "manual",
      "localizations": {
