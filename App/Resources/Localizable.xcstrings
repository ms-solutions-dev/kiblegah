      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Med harfi kelime sonunda, hemze sonraki kelimede: 4–5 hareke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dehnung am Wortende, Hamza im nächsten Wort: 4–5 Haraka."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prolongation at a word's end, hamza in the next word: 4–5 counts."
          }
        }
      }
    },
    "tecvid.madd_muttasil": {
