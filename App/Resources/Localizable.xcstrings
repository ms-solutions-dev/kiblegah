        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose my city myself"
          }
        }
      }
    },
    "onboarding.mushaf.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin mushaf bir kez iner; sonra internet olmadan da sayfa sayfa okursun. Ayarlar’dan istediğin zaman değiştirebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Mushaf wird einmal geladen, danach liest du Seite für Seite auch ohne Internet. Unter Ayarlar kannst du ihn jederzeit wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mushaf you choose downloads once; after that you can read page by page without internet. You can change it any time in Settings."
          }
        }
      }
    },
