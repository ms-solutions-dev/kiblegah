    "onboarding.konum.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitlerini bulunduğun yere göre hesaplamak ve Kıble yönünü göstermek için. İstemezsen şehrini kendin seçebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Gebetszeiten für deinen Ort zu berechnen und die Qibla-Richtung zu zeigen. Möchtest du das nicht, wählst du deine Stadt selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To calculate prayer times for where you are and show the Qibla direction. If you'd rather not, pick your city yourself."
          }
        }
      }
    },
    "onboarding.konum.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunu ne için kullanıyoruz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür wir deinen Standort brauchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why we use your location"
          }
        }
      }
    },
