          "stringUnit": {
            "state": "translated",
            "value": "İdğam-ı mütekâribeyn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Idgham naher Artikulation"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idgham of close articulation"
          }
        }
      }
    },
    "tecvid.idghaam_mutaqaribayn.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahreçleri yakın iki harf: ilki ikincisine katılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei nah beieinander artikulierte Buchstaben: der erste geht im zweiten auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two letters articulated close together: the first merges into the second."
          }
        }
      }
    },
    "tecvid.idghaam_no_ghunnah": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İdğam-ı bilâ gunne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Idgham ohne Ghunna"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idgham without ghunnah"
          }
        }
      }
    },
    "tecvid.idghaam_no_ghunnah.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenvin ya da sakin nun; ل ve ر harflerine gunnesiz katılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanwin oder Nun mit Sukun verschmilzt ohne Nasalierung mit ل und ر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanween or silent nun merges into ل and ر without nasalisation."
          }
        }
      }
    },
    "tecvid.idghaam_shafawi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İdğam-ı şefevî"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lippen-Idgham"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labial idgham"
          }
        }
      }
    },
    "tecvid.idghaam_shafawi.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin mim, sonraki mime gunne ile katılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mim mit Sukun verschmilzt mit dem folgenden Mim, nasal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A silent meem merges into the following meem, nasalised."
          }
        }
      }
    },
    "tecvid.ikhfa": {
