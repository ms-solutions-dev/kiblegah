    "takvim.bos": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki günler için kayıt yok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Einträge für die nächste Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No upcoming entries."
          }
        }
      }
    },
    "takvim.not": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyanet listesi geldiyse tarihler ondan; yoksa hesaplanır ve „yaklaşık“ yazılır. Kandil geceleri, yazan günün akşamı başlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegt die Diyanet-Liste vor, kommen die Daten daher; sonst werden sie berechnet und als „ungefähr“ markiert. Kandil-Nächte beginnen am Abend des genannten Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the Diyanet list is available, dates come from it; otherwise they are calculated and marked “approx.”. Kandil nights begin on the evening of the given day."
          }
        }
      }
    },
    "tecvid.ghunnah": {
      "extractionState": "manual",
      "localizations": {
