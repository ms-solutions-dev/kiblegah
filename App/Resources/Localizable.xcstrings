    "onboarding.slogan": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit, kıble, Kur'an ve dua. Reklamsız, takipsiz, senin için."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebetszeiten, Qibla, Koran und Duas. Ohne Werbung, ohne Tracking, für dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times, Qibla, Quran and duas. No ads, no tracking, made for you."
