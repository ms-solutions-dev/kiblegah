    "onboarding.basla": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlayalım"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Los geht's"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's start"
          }
        }
      }
    },
    "onboarding.basla.alt": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra konum ve bildirim iznini, nedenini anlatarak soracağız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach fragen wir nach Standort und Mitteilungen und erklären vorher, warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next we'll ask for location and notifications and explain why first."
          }
        }
      }
    },
    "onboarding.bildirim.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her vakit için ayrı ayarlayabilir, istersen önceden hatırlatma ya da ezan sesi seçebilirsin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du stellst jede Gebetszeit einzeln ein, auf Wunsch mit Erinnerung vorher oder Adhan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can set each prayer time separately, with an early reminder or the adhan if you like."
          }
        }
      }
    },
    "onboarding.bildirim.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit girince haber verelim mi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen wir dir Bescheid geben, wenn die Gebetszeit beginnt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we let you know when it's time to pray?"
          }
        }
      }
    },
    "onboarding.devam": {
