          }
        }
      }
    },
    "kible.konum_yok.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehrini seç, yönü hemen hesaplayalım. Konumun cihazında kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl deine Stadt, dann berechnen wir die Richtung. Dein Ort bleibt auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your city and we'll calculate the direction. Your location stays on your device."
          }
        }
      }
    },
    "kible.konum_yok.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıble için konumun gerekli"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Qibla brauchen wir deinen Ort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your location for the Qibla"
          }
        }
      }
    },
    "kible.parazit.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusula şu an güvenilir değil. Yanlış yöne kılma diye yönü göstermiyoruz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kompass ist gerade nicht verlässlich. Damit du nicht in die falsche Richtung betest, zeigen wir keine Richtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compass isn't reliable right now. We're not showing a direction so you don't pray the wrong way."
          }
        }
      }
    },
    "kible.parazit.arac": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçtaysan dışarı çık. Parazit geçince yön kendiliğinden geri gelir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Auto: steig aus. Ist die Störung weg, kommt die Richtung von selbst zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're in a car, step outside. The direction returns once the interference is gone."
          }
        }
      }
    },
    "kible.parazit.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manyetik parazit var"
