    "tecvid.madd_6.aciklama": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Med harfinden sonra sabit sükûn ya da şedde gelir: 6 hareke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Dehnungsbuchstaben folgt ein festes Sukun oder Schadda: 6 Haraka."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed sukun or shadda follows: 6 counts."
          }
        }
      }
    },
