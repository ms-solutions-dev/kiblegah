    "kible.gunes.baslik": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneşe göre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Sonne"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By the sun"
          }
        }
      }
    },
    "kible.gunes.batti": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş şu an görünmüyor. Haritayı kullan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne ist gerade nicht zu sehen. Nutz die Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun isn't visible right now. Use the map."
          }
        }
      }
    },
    "kible.gunes.ipucu": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusula gerekmez. Güneşe asla doğrudan bakma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganz ohne Kompass. Schau nie direkt in die Sonne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compass needed. Never look directly at the sun."
          }
        }
      }
    },
    "kible.gunes.sag %lld": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneşe dön, sonra %lld° sağa dön: Kıble orada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau zur Sonne, dann dreh dich %lld° nach rechts: Dort ist die Qibla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face the sun, then turn %lld° to the right: that's the Qibla."
          }
        }
      }
    },
    "kible.gunes.sol %lld": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneşe dön, sonra %lld° sola dön: Kıble orada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau zur Sonne, dann dreh dich %lld° nach links: Dort ist die Qibla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face the sun, then turn %lld° to the left: that's the Qibla."
          }
        }
      }
    },
