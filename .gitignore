# The Xcode project is generated from project.yml (xcodegen generate)
*.xcodeproj
*.xcworkspace
.build/
build/
DerivedData/
.DS_Store
__pycache__/
*.xcuserstate
# Info.plist files are generated by XcodeGen
App/Info*.plist
Widget/Info*.plist
Watch/Info*.plist
Watch/Widget/Info*.plist
# Personal build settings (team, relay host)
Config/Local.xcconfig
# Content packs are built locally from their original sources (tools/content/fetch.sh)
App/Resources/Paketler/*
!App/Resources/Paketler/.gitkeep
tools/content/sources/
tools/content/.venv/
# Relay
relay/node_modules/
relay/.dev.vars
relay/.wrangler/
