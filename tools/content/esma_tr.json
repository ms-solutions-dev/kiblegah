[
  {"nr": 1, "arabisch": "الله", "okunus_tr": "Allah", "anlam_tr": "Tek ilah olan Yüce Yaratıcı'nın özel adı"},
  {"nr": 2, "arabisch": "ٱلرَّحْمَٰنُ", "okunus_tr": "er-Rahmân", "anlam_tr": "Merhameti sonsuz, lütfu bol olan"},
  {"nr": 3, "arabisch": "ٱلرَّحِيمُ", "okunus_tr": "er-Rahîm", "anlam_tr": "Çok merhamet eden, esirgeyen"},
  {"nr": 4, "arabisch": "ٱلْمَلِكُ", "okunus_tr": "el-Melik", "anlam_tr": "Her şeye hükmeden gerçek hükümdar"},
  {"nr": 5, "arabisch": "ٱلْقُدُّوسُ", "okunus_tr": "el-Kuddûs", "anlam_tr": "Hiçbir eksiği olmayan, tertemiz ve kutsal olan"},
  {"nr": 6, "arabisch": "ٱلسَّلَامُ", "okunus_tr": "es-Selâm", "anlam_tr": "Esenlik kaynağı, her kusurdan uzak olan"},
  {"nr": 7, "arabisch": "ٱلْمُؤْمِنُ", "okunus_tr": "el-Mü’min", "anlam_tr": "Kullarına emniyet bağışlayan, vaadinden dönmeyen"},
  {"nr": 8, "arabisch": "ٱلْمُهَيْمِنُ", "okunus_tr": "el-Müheymin", "anlam_tr": "Her şeyi gözetip idare eden"},
  {"nr": 9, "arabisch": "ٱلْعَزِيزُ", "okunus_tr": "el-Azîz", "anlam_tr": "Mağlup edilemeyen, izzet sahibi"},
  {"nr": 10, "arabisch": "ٱلْجَبَّارُ", "okunus_tr": "el-Cebbâr", "anlam_tr": "Hükmüne karşı konulamayan, dilediğini yürüten"},
  {"nr": 11, "arabisch": "ٱلْمُتَكَبِّرُ", "okunus_tr": "el-Mütekebbir", "anlam_tr": "Büyüklüğünü gösteren, yücelikte eşsiz"},
  {"nr": 12, "arabisch": "ٱلْخَالِقُ", "okunus_tr": "el-Hâlik", "anlam_tr": "Her şeyi bir ölçüye göre yaratan"},
  {"nr": 13, "arabisch": "ٱلْبَارِئُ", "okunus_tr": "el-Bâri’", "anlam_tr": "Örneksiz ve kusursuz biçimde yoktan var eden"},
  {"nr": 14, "arabisch": "ٱلْمُصَوِّرُ", "okunus_tr": "el-Musavvir", "anlam_tr": "Her varlığa kendine özgü biçim veren"},
  {"nr": 15, "arabisch": "ٱلْغَفَّارُ", "okunus_tr": "el-Gaffâr", "anlam_tr": "Günahları örtüp tekrar tekrar bağışlayan"},
  {"nr": 16, "arabisch": "ٱلْقَهَّارُ", "okunus_tr": "el-Kahhâr", "anlam_tr": "Her şeyi boyun eğdiren, yenilmez güç sahibi"},
  {"nr": 17, "arabisch": "ٱلْوَهَّابُ", "okunus_tr": "el-Vehhâb", "anlam_tr": "Hiçbir karşılık istemeden cömertçe bağışlayan"},
  {"nr": 18, "arabisch": "ٱلرَّزَّاقُ", "okunus_tr": "er-Rezzâk", "anlam_tr": "Her canlıya rızkını ulaştıran"},
  {"nr": 19, "arabisch": "ٱلْفَتَّاحُ", "okunus_tr": "el-Fettâh", "anlam_tr": "Kapalı kapıları açan, kullar arasında hakla hükmeden"},
  {"nr": 20, "arabisch": "ٱلْعَلِيمُ", "okunus_tr": "el-Alîm", "anlam_tr": "Her şeyi eksiksiz bilen"},
  {"nr": 21, "arabisch": "ٱلْقَابِضُ", "okunus_tr": "el-Kâbız", "anlam_tr": "Rızkı hikmetiyle daraltan, ruhları geri alan"},
  {"nr": 22, "arabisch": "ٱلْبَاسِطُ", "okunus_tr": "el-Bâsıt", "anlam_tr": "Dilediğine bolluk ve genişlik veren"},
  {"nr": 23, "arabisch": "ٱلْخَافِضُ", "okunus_tr": "el-Hâfıd", "anlam_tr": "İnkâr ve zulüm edenleri alçaltan"},
  {"nr": 24, "arabisch": "ٱلرَّافِعُ", "okunus_tr": "er-Râfi‘", "anlam_tr": "İnananları yüce makamlara çıkaran"},
  {"nr": 25, "arabisch": "ٱلْمُعِزُّ", "okunus_tr": "el-Muizz", "anlam_tr": "Dilediğini onurlandırıp güçlü kılan"},
  {"nr": 26, "arabisch": "ٱلْمُذِلُّ", "okunus_tr": "el-Müzill", "anlam_tr": "Dilediğini izzetten mahrum edip alçaltan"},
  {"nr": 27, "arabisch": "ٱلسَّمِيعُ", "okunus_tr": "es-Semî‘", "anlam_tr": "Her sesi ve her duayı işiten"},
  {"nr": 28, "arabisch": "ٱلْبَصِيرُ", "okunus_tr": "el-Basîr", "anlam_tr": "Her şeyi bütün açıklığıyla gören"},
  {"nr": 29, "arabisch": "ٱلْحَكَمُ", "okunus_tr": "el-Hakem", "anlam_tr": "Hükmü kesin, kararı son olan"},
  {"nr": 30, "arabisch": "ٱلْعَدْلُ", "okunus_tr": "el-Adl", "anlam_tr": "Adaletinden hiç sapmayan, tam adil olan"},
  {"nr": 31, "arabisch": "ٱللَّطِيفُ", "okunus_tr": "el-Latîf", "anlam_tr": "En ince ayrıntıyı bilen, lütufkâr olan"},
  {"nr": 32, "arabisch": "ٱلْخَبِيرُ", "okunus_tr": "el-Habîr", "anlam_tr": "Her şeyin özünü ve gizlisini bilen"},
  {"nr": 33, "arabisch": "ٱلْحَلِيمُ", "okunus_tr": "el-Halîm", "anlam_tr": "Yumuşak davranan, cezayı hemen vermeyen"},
  {"nr": 34, "arabisch": "ٱلْعَظِيمُ", "okunus_tr": "el-Azîm", "anlam_tr": "Büyüklüğü kavrayışı aşan, pek yüce"},
  {"nr": 35, "arabisch": "ٱلْغَفُورُ", "okunus_tr": "el-Gafûr", "anlam_tr": "Mağfireti geniş, bağışlaması bol olan"},
  {"nr": 36, "arabisch": "ٱلشَّكُورُ", "okunus_tr": "eş-Şekûr", "anlam_tr": "Küçük iyiliği büyük ödüllendiren"},
  {"nr": 37, "arabisch": "ٱلْعَلِيُّ", "okunus_tr": "el-Aliyy", "anlam_tr": "Yücelikte üstünü ve dengi olmayan"},
  {"nr": 38, "arabisch": "ٱلْكَبِيرُ", "okunus_tr": "el-Kebîr", "anlam_tr": "Her şeyden büyük, ulu olan"},
  {"nr": 39, "arabisch": "ٱلْحَفِيظُ", "okunus_tr": "el-Hafîz", "anlam_tr": "Her şeyi muhafaza eden, düzeni koruyan"},
  {"nr": 40, "arabisch": "ٱلْمُقِيتُ", "okunus_tr": "el-Mukît", "anlam_tr": "Her varlığın azığını ölçüyle verip koruyan"},
  {"nr": 41, "arabisch": "ٱلْحَسِيبُ", "okunus_tr": "el-Hasîb", "anlam_tr": "Kuluna kâfi gelen, her şeyin hesabını gören"},
  {"nr": 42, "arabisch": "ٱلْجَلِيلُ", "okunus_tr": "el-Celîl", "anlam_tr": "Azameti ve şanı her ölçünün ötesinde olan"},
  {"nr": 43, "arabisch": "الْكَرِيمُ", "okunus_tr": "el-Kerîm", "anlam_tr": "İkramı ve cömertliği sınırsız olan"},
  {"nr": 44, "arabisch": "الرَّقِيبُ", "okunus_tr": "er-Rakîb", "anlam_tr": "Her şeyi her an gözetim altında tutan"},
  {"nr": 45, "arabisch": "الْمُجِيبُ", "okunus_tr": "el-Mücîb", "anlam_tr": "Yalvaranın duasına icabet eden"},
  {"nr": 46, "arabisch": "الْوَاسِعُ", "okunus_tr": "el-Vâsi‘", "anlam_tr": "Rahmeti ve ilmi uçsuz bucaksız olan"},
  {"nr": 47, "arabisch": "الْحَكِيمُ", "okunus_tr": "el-Hakîm", "anlam_tr": "Yaptığı her şey hikmet dolu olan"},
  {"nr": 48, "arabisch": "الْوَدُودُ", "okunus_tr": "el-Vedûd", "anlam_tr": "Kullarını seven, sevilmeye en layık olan"},
  {"nr": 49, "arabisch": "الْمَجِيدُ", "okunus_tr": "el-Mecîd", "anlam_tr": "Şerefi üstün, ihsanı geniş olan"},
  {"nr": 50, "arabisch": "الْبَاعِثُ", "okunus_tr": "el-Bâis", "anlam_tr": "Elçiler gönderen, ölüleri yeniden dirilten"},
  {"nr": 51, "arabisch": "الشَّهِيدُ", "okunus_tr": "eş-Şehîd", "anlam_tr": "Olan biten her şeye şahit olan"},
  {"nr": 52, "arabisch": "الْحَقُّ", "okunus_tr": "el-Hakk", "anlam_tr": "Varlığı şüphe götürmez, tek gerçek ilah olan"},
  {"nr": 53, "arabisch": "الْوَكِيلُ", "okunus_tr": "el-Vekîl", "anlam_tr": "İşleri O'na bırakılan, en güvenilir dayanak"},
  {"nr": 54, "arabisch": "الْقَوِيُّ", "okunus_tr": "el-Kavî", "anlam_tr": "Kuvveti tam ve kusursuz olan"},
  {"nr": 55, "arabisch": "الْمَتِينُ", "okunus_tr": "el-Metîn", "anlam_tr": "Kudreti sarsılmaz, hiçbir yardıma muhtaç olmayan"},
  {"nr": 56, "arabisch": "الْوَلِيُّ", "okunus_tr": "el-Velî", "anlam_tr": "İnananları koruyan, onlara yardım eden dost"},
  {"nr": 57, "arabisch": "الْحَمِيدُ", "okunus_tr": "el-Hamîd", "anlam_tr": "Bütün övgülerin gerçek sahibi"},
  {"nr": 58, "arabisch": "الْمُحْصِي", "okunus_tr": "el-Muhsî", "anlam_tr": "Hiçbir şeyi sayımının dışında bırakmayan"},
  {"nr": 59, "arabisch": "الْمُبْدِئُ", "okunus_tr": "el-Mübdi’", "anlam_tr": "Varlıkları ilk kez meydana getiren"},
  {"nr": 60, "arabisch": "الْمُعِيدُ", "okunus_tr": "el-Muîd", "anlam_tr": "İlk yarattığını yeniden yaratan"},
  {"nr": 61, "arabisch": "الْمُحْيِي", "okunus_tr": "el-Muhyî", "anlam_tr": "Hayat bağışlayan, canlandıran"},
  {"nr": 62, "arabisch": "الْمُمِيتُ", "okunus_tr": "el-Mümît", "anlam_tr": "Ölümü takdir eden ve yaratan"},
  {"nr": 63, "arabisch": "الْحَيُّ", "okunus_tr": "el-Hayy", "anlam_tr": "Ezelden ebede diri olan"},
  {"nr": 64, "arabisch": "الْقَيُّومُ", "okunus_tr": "el-Kayyûm", "anlam_tr": "Zatıyla var olan, bütün varlığı ayakta tutup yöneten"},
  {"nr": 65, "arabisch": "الْوَاجِدُ", "okunus_tr": "el-Vâcid", "anlam_tr": "Hiçbir şeyden yoksun olmayan, dilediğini bulan"},
  {"nr": 66, "arabisch": "الْمَاجِدُ", "okunus_tr": "el-Mâcid", "anlam_tr": "Yüce şan ve tükenmez cömertlik sahibi"},
  {"nr": 67, "arabisch": "الْوَاحِدُ", "okunus_tr": "el-Vâhid", "anlam_tr": "Bir ve tek, hiçbir ortağı bulunmayan"},
  {"nr": 68, "arabisch": "الصَّمَدُ", "okunus_tr": "es-Samed", "anlam_tr": "Her ihtiyaçta başvurulan, kendisi ihtiyaçsız olan"},
  {"nr": 69, "arabisch": "الْقَادِرُ", "okunus_tr": "el-Kâdir", "anlam_tr": "Kudretinin yetmediği hiçbir şey olmayan"},
  {"nr": 70, "arabisch": "الْمُقْتَدِرُ", "okunus_tr": "el-Muktedir", "anlam_tr": "Sınırsız kudretiyle her şeyde dilediğince tasarruf eden"},
  {"nr": 71, "arabisch": "الْمُقَدِّمُ", "okunus_tr": "el-Mukaddim", "anlam_tr": "Hikmetine göre öne çıkaran"},
  {"nr": 72, "arabisch": "الْمُؤَخِّرُ", "okunus_tr": "el-Muahhir", "anlam_tr": "Hikmetine göre geride bırakan"},
  {"nr": 73, "arabisch": "الْأَوَّلُ", "okunus_tr": "el-Evvel", "anlam_tr": "Öncesi olmayan, her şeyden önce var olan"},
  {"nr": 74, "arabisch": "الْآخِرُ", "okunus_tr": "el-Âhir", "anlam_tr": "Sonrası olmayan, her şeyden sonra kalan"},
  {"nr": 75, "arabisch": "الظَّاهِرُ", "okunus_tr": "ez-Zâhir", "anlam_tr": "Varlığı delilleriyle apaçık olan"},
  {"nr": 76, "arabisch": "الْبَاطِنُ", "okunus_tr": "el-Bâtın", "anlam_tr": "Zatı gözlerden ve akıllardan gizli olan"},
  {"nr": 77, "arabisch": "الْوَالِي", "okunus_tr": "el-Vâlî", "anlam_tr": "Yaratılmışların bütün işlerini üstlenip düzene koyan"},
  {"nr": 78, "arabisch": "الْمُتَعَالِ", "okunus_tr": "el-Müteâlî", "anlam_tr": "Yaratılmışların hepsinin üstünde, pek yüce"},
  {"nr": 79, "arabisch": "الْبَرُّ", "okunus_tr": "el-Berr", "anlam_tr": "Kullarına bolca iyilik eden"},
  {"nr": 80, "arabisch": "التَّوَّابُ", "okunus_tr": "et-Tevvâb", "anlam_tr": "Kulunu pişmanlığa erdirip dönüşünü kabul eden"},
  {"nr": 81, "arabisch": "الْمُنْتَقِمُ", "okunus_tr": "el-Müntakım", "anlam_tr": "Suçlulara hak ettikleri cezayı veren"},
  {"nr": 82, "arabisch": "الْعَفُوُّ", "okunus_tr": "el-Afüvv", "anlam_tr": "Günahları tamamen silen, çok affeden"},
  {"nr": 83, "arabisch": "الرَّؤُوفُ", "okunus_tr": "er-Raûf", "anlam_tr": "Kullarına karşı çok şefkatli"},
  {"nr": 84, "arabisch": "مَالِكُ الْمُلْكِ", "okunus_tr": "Mâlikü’l-mülk", "anlam_tr": "Her şeyin mülkü elinde olan, mutlak hükümran"},
  {"nr": 85, "arabisch": "ذُو الْجَلَالِ وَالْإِكْرَامِ", "okunus_tr": "Zü’l-celâli ve’l-ikrâm", "anlam_tr": "Heybet, yücelik ve cömertlik sahibi"},
  {"nr": 86, "arabisch": "الْمُقْسِطُ", "okunus_tr": "el-Muksit", "anlam_tr": "Zulme uğrayanın hakkını gözetip adaleti sağlayan"},
  {"nr": 87, "arabisch": "الْجَامِعُ", "okunus_tr": "el-Câmi‘", "anlam_tr": "Zıtları bir arada tutan, kıyamette herkesi toplayan"},
  {"nr": 88, "arabisch": "الْغَنِيُّ", "okunus_tr": "el-Ganî", "anlam_tr": "Zenginliği kendinden, ihtiyaçtan uzak olan"},
  {"nr": 89, "arabisch": "الْمُغْنِي", "okunus_tr": "el-Muğnî", "anlam_tr": "Dilediğini muhtaçlıktan kurtarıp zenginleştiren"},
  {"nr": 90, "arabisch": "الْمَانِعُ", "okunus_tr": "el-Mâni‘", "anlam_tr": "Dilemediğini ve zararlı olanı engelleyen"},
  {"nr": 91, "arabisch": "الضَّارُّ", "okunus_tr": "ed-Dârr", "anlam_tr": "Zararlı olanı da hikmetiyle yaratan"},
  {"nr": 92, "arabisch": "النَّافِعُ", "okunus_tr": "en-Nâfi‘", "anlam_tr": "Her türlü yararın kaynağı olan"},
  {"nr": 93, "arabisch": "النُّورُ", "okunus_tr": "en-Nûr", "anlam_tr": "Gökleri, yeri ve gönülleri aydınlatan"},
  {"nr": 94, "arabisch": "الْهَادِي", "okunus_tr": "el-Hâdî", "anlam_tr": "Hidayete ulaştıran, doğruya kılavuzlayan"},
  {"nr": 95, "arabisch": "الْبَدِيعُ", "okunus_tr": "el-Bedî‘", "anlam_tr": "Benzeri görülmemiş şekilde yaratan"},
  {"nr": 96, "arabisch": "الْبَاقِي", "okunus_tr": "el-Bâkî", "anlam_tr": "Varlığı hiç sona ermeyen, kalıcı olan"},
  {"nr": 97, "arabisch": "الْوَارِثُ", "okunus_tr": "el-Vâris", "anlam_tr": "Her şey sona erince mülkü kendisine kalan"},
  {"nr": 98, "arabisch": "الرَّشِيدُ", "okunus_tr": "er-Reşîd", "anlam_tr": "Kullarını doğruya yönelten, işinde hiç yanılmayan"},
  {"nr": 99, "arabisch": "الصَّبُورُ", "okunus_tr": "es-Sabûr", "anlam_tr": "Çok sabırlı, kullarına süre tanıyan"}
]
